ame="PortSheet",\n        material="vacuum"\n    )\n\n# Air region for radiation boundary\ntry:\n    air = hfss.modeler.create_box(\n        origin=["-sub_W/2-air_margin_xy", "-sub_L/2-air_margin_xy", "-air_margin_z"],\n        sizes=["sub_W+2*air_margin_xy", "sub_L+2*air_margin_xy", "h_sub+t_cu+2*air_margin_z"],\n        name="AirBox",\n        material="air"\n    )\n    hfss.assign_radiation_boundary_to_objects("AirBox", boundary_name="Rad1")\nexcept Exception:\n    air = None\n\n# -------------------------------------------------------------------------\n# Excitation Port1. Try wave-port assignment first; fall back to lumped port\n# if the active PyAEDT API/geometry rules reject a wave port on this sheet.\n# -------------------------------------------------------------------------\nport_assigned = False\nintegration_line = [["0mm", "-sub_L/2", "0mm"], ["0mm", "-sub_L/2", "h_sub+t_cu"]]\ntry:\n    hfss.wave_port(\n        assignment="PortSheet",\n        create_port_sheet=False,\n        integration_line=integration_line,\n        name="Port1",\n        modes=1,\n        impedance=50\n    )\n    port_assigned = True\nexcept Exception as e1:\n    try:\n        hfss.create_wave_port_from_sheet(\n            sheet="PortSheet",\n            axisdir=2,\n            name="Port1",\n            impedance=50\n        )\n        port_assigned = True\n    except Exception as e2:\n        try:\n            hfss.lumped_port(\n                assignment="PortSheet",\n                create_port_sheet=False,\n                integration_line=integration_line,\n                impedance=50,\n                name="Port1"\n            )\n            port_assigned = True\n        except Exception as e3:\n            raise RuntimeError(f"Could not assign Port1. wave_port error={e1}; create_wave_port_from_sheet error={e2}; lumped_port error={e3}")\n\n# -------------------------------------------------------------------------\n# Analysis setup and broadband interpolating/discrete sweep