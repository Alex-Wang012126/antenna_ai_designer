				High[3: 40, 35, 0]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '34'
		$begin '46'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -24.199999999999999, -35, 3.1749999999999998]
				High[3: 24.199999999999999, 19.699999999999999, 3.1749999999999998]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '46'
		$begin '74'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -4.75, -35, 0]
				High[3: 4.75, -35, 3.1749999999999998]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '74'
		$begin '86'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -65, -60, -14.999999999999996]
				High[3: 65, 60, 38.174999999999997]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '86'
	$end 'BodyCaches'
	$begin 'IntersectionCaches'
	$end 'IntersectionCaches'
$end 'InterrogationCache'
