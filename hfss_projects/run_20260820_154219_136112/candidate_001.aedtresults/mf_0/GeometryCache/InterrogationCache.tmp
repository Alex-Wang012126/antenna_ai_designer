$begin 'InterrogationCache'
	Version=1
	$begin 'ValidationStatus'
		$begin 'Options'
			EntityCheckLevel='Strict'
			IgnoreUnclassifiedObjects=false
			SkipIntersectionChecks=false
		$end 'Options'
		Status=true
	$end 'ValidationStatus'
	$begin 'BodyCaches'
		$begin '6'
			$begin 'CheckStatus'
				CheckLevel=20
				Status=true
			$end 'CheckStatus'
			$begin 'BoundingBox'
				Low[3: -40, -35, 0]
				High[3: 40, 35, 3.1749999999999998]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '6'
		$begin '34'
			$begin 'CheckStatus'
				CheckLevel=20
