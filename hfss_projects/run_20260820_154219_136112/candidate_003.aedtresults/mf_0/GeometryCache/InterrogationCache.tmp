$begin 'InterrogationCache'
	Version=1
	$begin 'ValidationStatus'
		$begin 'Options'
			EntityCheckLevel='Strict'
			IgnoreUnclassifiedObjects=false
			SkipIntersectionChecks=false
		$end 'Options'
		Status=false
	$end 'ValidationStatus'
	$begin 'BodyCaches'
		$begin '86'
			$begin 'BoundingBox'
				Low[3: -80, -72.5, -17.999999999999996]
				High[3: 80, 72.5, 50]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '86'
		$begin '195'
			$begin 'BoundingBox'
				Low[3: -50, -42.5, 0]
				High[3: 50, 42.5, 5]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '195'
		$begin '223'
			$begin 'BoundingBox'
				Low[3: -50, -42.5, 0]
				High[3: 50, 42.5, 0]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '223'
		$begin '235'
			$begin 'BoundingBox'
				Low[3: -28.999999999999996, -42.499999999999993, 5]
				High[3: 28.999999999999996, 19.200000000000003, 5]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '235'
		$begin '263'
			$begin 'BoundingBox'
				Low[3: -6, -42.5, 0]
				High[3: 6, -42.5, 5]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '263'
	$end 'BodyCaches'
	$begin 'IntersectionCaches'
	$end 'IntersectionCaches'
$end 'InterrogationCache'
