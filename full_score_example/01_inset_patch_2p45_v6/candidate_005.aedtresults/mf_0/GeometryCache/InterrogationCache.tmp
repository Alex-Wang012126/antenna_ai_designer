				Valid=true
			$end 'BoundingBox'
		$end '357'
		$begin '385'
			$begin 'BoundingBox'
				Low[3: -45, -40, 0]
				High[3: 45, 40, 0]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '385'
		$begin '397'
			$begin 'BoundingBox'
				Low[3: -30, -40, 5]
				High[3: 30, 19.149999999999999, 5]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '397'
		$begin '425'
			$begin 'BoundingBox'
				Low[3: -7.0000000000000009, -40, 0]
				High[3: 7.0000000000000009, -40, 5]
				Exact=true
				Valid=true
			$end 'BoundingBox'
		$end '425'
	$end 'BodyCaches'
	$begin 'IntersectionCaches'
	$end 'IntersectionCaches'
$end 'InterrogationCache'
